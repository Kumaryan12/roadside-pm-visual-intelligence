# ============================================================
# Operating system and editors
# ============================================================
.DS_Store
**/.DS_Store
.vscode/
.idea/
*~
*.bak
*.save
*_backup.py

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ============================================================
# Virtual environments and local secrets
# ============================================================
.venv/
.venv_torch/
venv/
env/
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*service_account*.json

# ============================================================
# Local caches and temporary directories
# ============================================================
.cache/
.matplotlib-cache/
tmp/
temp/

# ============================================================
# Generated project artifacts
# Keep artifacts/README.md, but not run contents
# ============================================================
artifacts/cache/
artifacts/runs/
output/
outputs/

# ============================================================
# Raw/intermediate datasets
# Keep data/schemas and data/manifests
# ============================================================
data/raw/
data/interim/
data/processed/
data/external/
data/sensor/

experiments/**/data/
experiments/**/embeddings/
experiments/**/models/
experiments/**/logs/
experiments/**/outputs/
experiments/**/figures/
experiments/**/notebooks/

# ============================================================
# Large model and array files
# ============================================================
*.npy
*.npz
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.ckpt
*.h5
*.hdf5

# Keep model registry, ignore downloaded detector weights
models/detectors/

# ============================================================
# Raw media and large archives
# Documentation figures remain allowed
# ============================================================
*.mp4
*.avi
*.mov
*.mkv
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# ============================================================
# Per-row prediction dumps
# Aggregate metrics/results remain allowed
# ============================================================
**/predictions.csv
**/predictions_*.csv
**/*_predictions.csv
**/*predictions*.csv
**/all_fold_predictions.csv
**/all_fold_*_predictions.csv

# Generated raw indexes/audit extracts
**/*_image_file_index.csv
**/*_csv_head*.csv

# ============================================================
# Logs
# ============================================================
*.log

# ============================================================
# LaTeX build products
# Do not ignore PDF globally: the final report PDF is retained
# ============================================================
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.xdv

# Generated local inventory
project_file_inventory.txt

# ============================================================
# Explicitly retain the internship report
# ============================================================
!docs/internship_report/
!docs/internship_report/**
